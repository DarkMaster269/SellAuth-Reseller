# ==========================================
# resell-sellauth Environment Configuration
# NEVER commit real secrets or production keys
# ==========================================

# SellAuth Store Settings
SELLAUTH_API_KEY=sk_test_FAKESELLAUTHKEY1234567890
SELLAUTH_SHOP_ID=226299
SELLAUTH_WEBHOOK_SECRET=fake_webhook_secret_for_testing_only

# Database
SQLITE_PATH=resell.db

# Mapping file location
MAPPING_FILE=mapping.yaml

# Safety & Spend Limits (amounts in satoshis: 1 LTC = 100,000,000 sats)
# 0.05 LTC max per purchase (~$4-5)
MAX_SPEND_PER_ORDER_SATS=5000000
# 0.5 LTC max spend per day
MAX_SPEND_PER_DAY_SATS=50000000
# Float floor: pause purchasing if balance drops below 0.1 LTC
MIN_WALLET_BALANCE_SATS=10000000

# Margins & Timeouts
MARGIN_FLOOR_USD=1.50
DELAYED_THRESHOLD_SECONDS=180
GIVEUP_THRESHOLD_SECONDS=1800

# Electrum-LTC Local JSON-RPC
ELECTRUM_RPC_URL=http://127.0.0.1:7773
ELECTRUM_RPC_USER=electrum_fake_user
ELECTRUM_RPC_PASSWORD=electrum_fake_password

# Alerts (Optional in dev, required in production)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/fake/fake_alert_token

